<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="Admin.Master.cs"
    Inherits="StudySwap.Admin.Admin" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>
        <asp:ContentPlaceHolder ID="TitleContent" runat="server">
            StudySwap Admin
        </asp:ContentPlaceHolder>
    </title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

    <style>
        body { margin: 0; background: #f4f6f9; }

        /* Sidebar */
        .sidebar {
            position: fixed; top: 0; left: 0;
            height: 100vh; width: 220px;
            background: #2c3e50; color: #fff;
            transition: all 0.3s ease;
            z-index: 1050;
            display: flex; flex-direction: column;
        }
        .sidebar.collapsed { width: 70px; }

        .sidebar .brand {
            padding: 1rem; text-align: center; font-weight: 700;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            white-space: nowrap; overflow: hidden;
        }

        .sidebar nav { flex: 1; overflow-y: auto; }

        .sidebar a {
            display: flex; align-items: center;
            padding: 12px 16px;
            color: rgba(255,255,255,0.85);
            text-decoration: none;
            border-left: 3px solid transparent;
            white-space: nowrap;
        }
        .sidebar a:hover {
            background: rgba(255,255,255,0.10);
            color: #fff;
        }
        .sidebar a.active {
            background: rgba(255,255,255,0.16);
            color: #fff;
            border-left-color: #0078d4;
            font-weight: 600;
        }
        .sidebar i { width: 25px; text-align: center; }

        .sidebar.collapsed span { display: none; }
        .sidebar.collapsed a { justify-content: center; padding-left: 0; padding-right: 0; }

        /* Logout pinned to bottom */
        .sidebar .logout-wrap {
            border-top: 1px solid rgba(255,255,255,0.1);
        }
        .sidebar .logout-wrap a:hover {
            background: rgba(220, 53, 69, 0.25);
        }

        /* Main content */
        .main-content {
            margin-left: 220px;
            transition: margin-left 0.3s ease;
            min-height: 100vh;
        }
        .main-content.collapsed { margin-left: 70px; }

        /* Topbar */
        .topbar {
            background: #fff;
            padding: 0.75rem 1rem;
            box-shadow: 0 1px 5px rgba(0,0,0,0.08);
            display: flex; justify-content: space-between; align-items: center;
            position: sticky; top: 0; z-index: 100;
        }
        .topbar .admin-info {
            display: flex; align-items: center; gap: 12px;
            font-weight: 600; color: #333;
        }
        .topbar .admin-info i { color: #0078d4; }

        /* Mobile */
        @media (max-width: 768px) {
            .sidebar { left: -220px; }
            .sidebar.show { left: 0; }
            .main-content, .main-content.collapsed { margin-left: 0; }
            .overlay {
                position: fixed; inset: 0; background: rgba(0,0,0,0.4);
                display: none; z-index: 1040;
            }
            .overlay.show { display: block; }
        }
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server" />
</head>

<body>
<form runat="server">

    <!-- Mobile overlay -->
    <div id="overlay" class="overlay"></div>

    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="brand">StudySwap</div>

        <nav>
            <a href="AdminDashboard.aspx" runat="server" id="lnkDashboard">
                <i class="fas fa-home"></i>
                <span>Dashboard</span>
            </a>

            <a href="VerifyStudent.aspx" runat="server" id="lnkVerifyStudents">
                <i class="fas fa-user-check"></i>
                <span>Verify Students</span>
            </a>

            <a href="AddCollegeData.aspx" runat="server" id="lnkColleges">
                <i class="fas fa-university"></i>
                <span>Add Colleges</span>
            </a>

            
            <!-- ✅ NEW: Add Department Menu -->
            <a href="AddDepartment.aspx" runat="server" id="lnkAddDepartment">
                <i class="fas fa-building"></i>
                <span>Add Department</span>
            </a>

            <a href="AddCourse.aspx" runat="server" id="lnkCourses">
                <i class="fas fa-book"></i>
                <span>Add Course</span>
            </a>

            <!-- ✅ Add Category Menu -->
            <a href="AddCategory.aspx" runat="server" id="lnkAddCategory">
                <i class="fas fa-tags"></i>
                <span>Add Category</span>
            </a>

            <a href="ViewListing.aspx" runat="server" id="lnkListings">
                <i class="fas fa-list-alt"></i>
                <span>View Listings</span>
            </a>

            <a href="~/Admin/ViewContactList.aspx" runat="server" id="A1">
                <i class="fas fa-list-alt"></i>
                <span>View Contacted Student</span>
            </a>

            <a href="ViewUsers.aspx" runat="server" id="lnkUsers">
                <i class="fas fa-users-cog"></i>
                <span>Manage Students</span>
            </a>

            <a href="ViewComplaints.aspx" runat="server" id="lnkComplaints">
                <i class="fas fa-comment-dots"></i>
                <span>Complaints</span>
            </a>
        </nav>

        <div class="logout-wrap">
            <a href="../Default.aspx">
                <i class="fas fa-sign-out-alt"></i>
                <span>Logout</span>
            </a>
        </div>
    </aside>

    <!-- Main Content -->
    <div class="main-content" id="mainContent">
        <div class="topbar">
            <button type="button" id="toggleBtn" class="btn btn-light">
                <i class="fas fa-bars"></i>
            </button>

            <div class="admin-info">
                <i class="fas fa-user-shield"></i>
                <asp:Label ID="lblAdminName" runat="server" Text="Admin"></asp:Label>
            </div>
        </div>

        <div class="p-3">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server" />
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const sidebar = document.getElementById('sidebar');
        const main = document.getElementById('mainContent');
        const overlay = document.getElementById('overlay');

        document.getElementById('toggleBtn').onclick = function () {
            if (window.innerWidth <= 768) {
                sidebar.classList.toggle('show');
                overlay.classList.toggle('show');
            } else {
                sidebar.classList.toggle('collapsed');
                main.classList.toggle('collapsed');
            }
        };

        overlay.onclick = function () {
            sidebar.classList.remove('show');
            overlay.classList.remove('show');
        };
    </script>

</form>
</body>
</html>
